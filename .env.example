# ─────────────────────────────────────────────────────────────────────────────
# Marchés Publics Maroc — backend configuration
# Copy this file to `.env` (which is gitignored) and fill in real values:
#   cp .env.example .env
# The backend loads `.env` automatically at startup (python-dotenv).
# ─────────────────────────────────────────────────────────────────────────────

# ── SMTP / email digests (Brevo transactional relay) ────────────────────────
# These are now the FALLBACK. The admin space (Settings → Email, owner only)
# stores the same fields in the DB and overrides any value set here; a blank
# stored value falls back to the env var below. With neither set, run_digest()
# logs the digest instead of sending it.
# Brevo dashboard → SMTP & API → SMTP: the login is your account email, the
# password is the generated "SMTP key" (NOT your Brevo account password).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@example.com
SMTP_PASSWORD=your-brevo-smtp-key
# From address shown to recipients. Use an address on a domain you've verified
# in Brevo (SPF + DKIM) for deliverability. Falls back to SMTP_USER if unset.
SMTP_FROM=alertes@votredomaine.ma
# Optional display name shown next to the From address (e.g. "Marchés Publics Maroc").
SMTP_FROM_NAME=

# ── App ──────────────────────────────────────────────────────────────────────
# Secret used to sign session tokens (JWT HMAC). MUST be set in any deployed
# environment: if left blank the backend falls back to a random per-boot value,
# which silently logs every user out on each restart/redeploy. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Public URL of the frontend, used to build tender/alert links inside emails.
FRONTEND_URL=http://localhost:5173

# Hour of day (0–23, server local time) the daily scrape+digest job runs.
DIGEST_HOUR=7

# Comma-separated emails promoted to admin/owner on startup.
ADMIN_EMAILS=

# Claude API key for the legal-assistant chat feature.
ANTHROPIC_API_KEY=
